# Supabase Configuration
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here

# Public app URL used for Stripe Checkout success/cancel redirects.
# Local: http://localhost:5173
VITE_APP_URL=http://localhost:5173

# Stripe secrets are NOT Vite variables. Set them as Supabase Edge Function
# secrets (see docs/stripe-setup.md):
#   supabase secrets set STRIPE_SECRET_KEY=...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=...
#   supabase secrets set STRIPE_PRICE_MONTHLY=...
#   supabase secrets set STRIPE_PRICE_YEARLY=...
#   supabase secrets set STRIPE_PRICE_LIFETIME=...
#   supabase secrets set APP_URL=https://your-app.example
#
# Stripe Tax is optional and billed per transaction by Stripe. Leave it unset
# (or false) until tax registrations and prices are configured.
#   supabase secrets set STRIPE_AUTOMATIC_TAX=true
#
# Transactional email (password resets, confirmations) is configured in the
# Supabase dashboard, not in this file. See docs/email-setup.md.
